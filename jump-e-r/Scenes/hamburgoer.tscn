[ext_resource type="Texture2D" uid="uid://bxarvktppin" path="res://Assets/Burgur.png" id="1_n5fnt"]

[sub_resource type="GDScript" id="GDScript_n5fnt"]
resource_name = "Hamburger move"
script/source = "extends Area2D

@export var distance_behind: float = 100.0

var player: CharacterBody2D
var last_direction: float = 1.0


func _on_body_entered(body: Node2D) -> void:
	if body is CharacterBody2D:
		player = body


func _process(_delta: float) -> void:
	if not is_instance_valid(player):
		return

	# Remember the player's last horizontal direction
	if player.velocity.x != 0:
		last_direction = sign(player.velocity.x)

	# Place this Area2D behind the player
	global_position = player.global_position - Vector2(
		last_direction * distance_behind,
		0
	)
"

[sub_resource type="CircleShape2D" id="CircleShape2D_n5fnt"]
